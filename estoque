public class array2 {
    public static void main(String[] args){

      String[] produtos = {"calça", "bermuda", "jeans"};
      int[] estoque = {9,11,40};
      int[] precos = {20,30,40};


      for(int x = 0; x< estoque.length;x++){
          if(estoque[x] > 10) {
              System.out.println(produtos[x] +":" + precos[x] + " "+ "reais");
          }
      }
    }
}
